# Copia este archivo como .env (no se versiona). Valores solo para desarrollo local.

DJANGO_SECRET_KEY=cambia-esta-clave-solo-para-desarrollo
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ruta del admin de mantenimiento interno.
DJANGO_ADMIN_URL=admin/

# Servicios del docker-compose de desarrollo (infra/docker-compose.dev.yml).
DATABASE_URL=postgis://flotaagil:flotaagil-dev@db:5432/flotaagil
REDIS_URL=redis://redis:6379/0

# Duración de los tokens (minutos / horas).
JWT_ACCESS_MIN=15
JWT_REFRESH_HORAS=12
# En producción la cookie del refresh debe ser Secure; en desarrollo (http) no.
JWT_COOKIE_SECURE=false

# Duración máxima de la sesión del panel desde el login, aunque se renueve (horas).
JWT_SESION_MAX_HORAS=12
# Orígenes permitidos para login, refresh y logout del panel (separados por coma, sin barra final).
# Desarrollo: Vite y Swagger. Producción: solo el https público, p. ej. https://panel.flotaagil.example
PANEL_ORIGENES=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Bloqueo tras 5 intentos fallidos (USUARIO.intentos_fallidos): duración en minutos.
LOGIN_BLOQUEO_MIN=15

# Throttling por IP (login y portal público). El del portal es holgado: con el wifi del aeropuerto muchos
# pasajeros comparten IP, y el control principal es el límite por teléfono (más abajo).
THROTTLE_LOGIN=10/min
THROTTLE_PORTAL_MINUTO=20/min
THROTTLE_PORTAL_HORA=200/hour
# Proxies delante de Django. Desarrollo: vacío. Producción: obligatorio 1 (exactamente un proxy, Nginx en EC2,
# sin balanceador). Ver «Producción detrás de Nginx» en backend/README.md.
DJANGO_NUM_PROXIES=

# Portal: máximo de solicitudes por teléfono y empresa en la ventana (RN-06).
PORTAL_MAX_SOLICITUDES_POR_TELEFONO=3
PORTAL_VENTANA_TELEFONO_MIN=15

# Geocodificador: vacío = coordenadas de desarrollo; con clave = Google Geocoding API.
GOOGLE_GEOCODING_API_KEY=

# Contraseña de los usuarios sintéticos del comando datos_demo.
DATOS_DEMO_PASSWORD=demo-flotaagil-2026
